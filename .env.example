# Copy this file to .env and replace the placeholders. Never commit .env.
#
# The Databricks CLI does not automatically load this file. In bash, use:
#   set -a; source .env; set +a

# Databricks workspace authentication
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_CONFIG_PROFILE=DEFAULT

# Prefer OAuth authentication via `databricks auth login`. Only uncomment this
# when a personal access token is explicitly required by your workspace.
# DATABRICKS_TOKEN=replace-with-secret

# Optional deployment override. The production default is already the table below.
BUNDLE_VAR_output_table=workspace.monitoring.source_profile
